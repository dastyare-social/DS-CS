# PostgreSQL connection string.
# Example: postgresql://user:password@host:5432/db
DATABASE_URL="postgresql://user:password@localhost:6782/db"

# Admin account used by the bootstrap script.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Shared API key used by external clients for protected API routes.
# Send it as: Authorization: Bearer <your-key>
# Generate with: openssl rand -hex 32
API_KEY=replace-with-a-strong-secret
API_KEY_RATE_LIMIT_MAX_REQUESTS=30
API_KEY_RATE_LIMIT_WINDOW_MS=60000

# Optional: separate key that enables write tools on the standalone (stdio) MCP
# server. If unset, the stdio MCP server falls back to API_KEY above.
MCP_API_KEY=

# Better Auth configuration.
# BETTER_AUTH_URL should be your app's public URL.
# BETTER_AUTH_SECRET should be a long random secret.
BETTER_AUTH_URL="https://your-domain.com"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# The bootstrap script will create or update this admin user using the values above.
# It also reads the configured app name/username from config/app.config.json.

S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="dastyare-social-cs"
S3_FORCE_PATH_STYLE=true
# Public URL base for serving files (different from S3_ENDPOINT for some providers)
# For Supabase: https://your-project.supabase.co/storage/v1/object/public
# For MinIO/R2: https://your-domain.com
# For AWS S3: https://your-bucket.s3.amazonaws.com or https://s3.amazonaws.com/your-bucket
S3_PUBLIC_BASE_URL=""

# Media upload limits (MB). Uploads are validated against these per-kind caps.
# Images default to 10MB, videos 100MB, audio 25MB, generic files 25MB.
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_VIDEO_SIZE_MB=100
MEDIA_MAX_AUDIO_SIZE_MB=25
MEDIA_MAX_FILE_SIZE_MB=25
# Optional comma-separated MIME allowlist override.
# Example: "image/jpeg,image/png,video/mp4"
# When empty, the built-in allowlist is used:
#   image: image/jpeg, image/png, image/webp, image/gif, image/avif, image/svg+xml
#   video: video/mp4, video/webm, video/quicktime
#   audio: audio/mpeg, audio/mp4, audio/wav, audio/ogg, audio/aac, audio/flac
#   file:  application/pdf, text/plain
MEDIA_ALLOWED_MIME_TYPES=
# Storage key prefix for uploaded media (default: media)
MEDIA_KEY_PREFIX=media

NEXT_PUBLIC_ANIMATED_EMOJIES=false

# Dastyare Social SH — local URL shortener instance.
# Push notifications will shorten links via this service when configured.
# Leave empty to skip shortening (falls back to original URLs).
DS_SH_URL=
DS_SH_API_KEY=

# PostHog analytics configuration — Dastyare Social ORG project (581705).
# One token + one host shared by the browser and the server.
# The browser captures to the same-origin /ingest path, which next.config.ts
# rewrites to this host, so ad blockers cannot drop pageviews or recordings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="replace-with-public-project-token"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Relay server events to the Cloudflare reverse proxy (ingest.dastyare.social).
# Default true = on/send. Set to false to stop sending.
DISABLE_DEV_TEAM_PH=true

# PostHog bootstrap only (bun run bootstrap:posthog): phx_ key with admin scope.
PH_PROJECT_ID=581705
PH_PERSONAL_API_KEY="replace-with-phx-personal-api-key-with-admin-scope"

# Production domain for SEO and metadata
NEXT_PUBLIC_APP_URL="http://localhost:8729"
NEXT_PUBLIC_WEBPUSH_PUBLIC_KEY=""
WEBPUSH_PRIVATE_KEY=""
WEBPUSH_SUBJECT="mailto:you@example.com"

# Search Console helpers (disabled by default):
# Set NEXT_PUBLIC_ENABLE_SEARCH_CONSOLE=true to enable meta/file verification helpers.
NEXT_PUBLIC_ENABLE_SEARCH_CONSOLE=false

# When enabled, provide either a token or filename below.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION_FILE=
# Optional: exact HTML file content Google provided.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION_FILE_CONTENT=

# Control indexing globally. Default: indexing blocked unless explicitly enabled.
# Set to true in production when you are ready for search engines to index the site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Show internal nav links (default: hidden). Set true for admin previews.
NEXT_PUBLIC_SHOW_INTERNAL_NAV=false

# Additional image domains for Next.js Image optimization.
# Comma-separated list of domains (with or without protocol).
# Example: "example.com,cdn.example.com,https://storage.example.com"
NEXT_PUBLIC_ADDITIONAL_IMAGE_DOMAINS=